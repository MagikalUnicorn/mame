license:CC0-1.0
copyright-holders:MagikalUnicorn
-->
<mamelayout version="2">
	<element name="panel">
		<rect>
			<color red="0.05" green="0.05" blue="0.05" />
		</rect>
	</element>

	<element name="lamp" defstate="0">
		<rect state="0">
			<color red="0.30" green="0.24" blue="0.04" />
		</rect>
		<rect state="1">
			<color red="1.00" green="0.80" blue="0.10" />
		</rect>
	</element>

	<element name="external_low_label">
		<text string="EXTERNAL LATCH 0-7">
			<color red="0.85" green="0.85" blue="0.85" />
		</text>
	</element>

	<element name="external_high_label">
		<text string="EXTERNAL LATCH 8-15">
			<color red="0.85" green="0.85" blue="0.85" />
		</text>
	</element>

	<element name="port_a_label">
		<text string="MC68340 PORT A 16-23">
			<color red="0.85" green="0.85" blue="0.85" />
		</text>
	</element>

	<element name="lamp_label_0">
		<text string="0 A LEFT">
			<color red="0.00" green="0.00" blue="0.00" />
		</text>
	</element>
	<element name="lamp_label_1">
		<text string="1 B LEFT">
			<color red="0.00" green="0.00" blue="0.00" />
		</text>
	</element>
	<element name="lamp_label_2">
		<text string="2 C LEFT">
			<color red="0.00" green="0.00" blue="0.00" />
		</text>
	</element>
	<element name="lamp_label_3">
		<text string="3">
			<color red="0.00" green="0.00" blue="0.00" />
		</text>
	</element>
	<element name="lamp_label_4">
		<text string="4 START">
			<color red="0.00" green="0.00" blue="0.00" />
		</text>
	</element>
	<element name="lamp_label_5">
		<text string="5 C RIGHT">
			<color red="0.00" green="0.00" blue="0.00" />
		</text>
	</element>
	<element name="lamp_label_6">
		<text string="6 B RIGHT">
			<color red="0.00" green="0.00" blue="0.00" />
		</text>
	</element>
	<element name="lamp_label_7">
		<text string="7 A RIGHT">
			<color red="0.00" green="0.00" blue="0.00" />
		</text>
	</element>

	<repeat count="16">
		<param name="n" start="8" increment="1" />
		<element name="lamp_label_~n~">
			<text string="~n~">
				<color red="0.00" green="0.00" blue="0.00" />
			</text>
		</element>
	</repeat>

	<view name="Screen and Lamps">
		<screen index="0">
			<bounds x="0" y="0" width="768" height="576" />
		</screen>

		<element ref="panel">
			<bounds x="0" y="582" width="768" height="68" />
		</element>

		<element ref="external_low_label">
			<bounds x="4" y="588" width="136" height="12" />
		</element>
		<element ref="external_high_label">
			<bounds x="4" y="609" width="136" height="12" />
		</element>
		<element ref="port_a_label">
			<bounds x="4" y="630" width="136" height="12" />
		</element>

		<repeat count="3">
			<param name="s" start="0" increment="8" />
			<param name="y" start="586" increment="21" />
			<repeat count="8">
				<param name="n" start="~s~" increment="1" />
				<param name="x" start="146" increment="77" />
				<element name="lamp~n~" ref="lamp">
					<bounds x="~x~" y="~y~" width="70" height="16" />
				</element>
				<element ref="lamp_label_~n~">
					<bounds x="~x~" y="~y~" width="70" height="16" />
				</element>
			</repeat>
		</repeat>
	</view>

	<view name="Screen Only">
		<screen index="0">
			<bounds x="0" y="0" width="768" height="576" />
		</screen>
	</view>
</mamelayout>
