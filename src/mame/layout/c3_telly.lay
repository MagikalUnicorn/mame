			<bounds x="816" y="128" width="72" height="72" />
		</element>
		<element id="button6_face" name="lamp6" ref="lamp_green" inputtag="STROBE0" inputmask="0x40">
			<bounds x="816" y="236" width="72" height="72" />
		</element>
		<element ref="button_detail">
			<bounds x="816" y="236" width="72" height="72" />
		</element>
		<element id="button6_highlight" name="lamp6" ref="button_highlight">
			<bounds x="816" y="236" width="72" height="72" />
			<color red="0.42" green="0.66" blue="0.45" />
		</element>
		<element ref="lamp_label_6">
			<bounds x="816" y="236" width="72" height="72" />
		</element>
		<element id="button5_face" name="lamp5" ref="lamp_orange" inputtag="STROBE0" inputmask="0x20">
			<bounds x="816" y="344" width="72" height="72" />
		</element>
		<element ref="button_detail">
			<bounds x="816" y="344" width="72" height="72" />
		</element>
		<element id="button5_highlight" name="lamp5" ref="button_highlight">
			<bounds x="816" y="344" width="72" height="72" />
			<color red="0.69" green="0.52" blue="0.40" />
		</element>
		<element ref="lamp_label_5">
			<bounds x="816" y="344" width="72" height="72" />
