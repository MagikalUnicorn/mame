	<view name="Screen Only">
		<screen index="0">
			<bounds x="0" y="0" width="768" height="576" />
		</screen>
	</view>

	<script><![CDATA[
		local lamp_items = {
			{ number = 0, face = "button0_face", highlight = "button0_highlight" },
			{ number = 1, face = "button1_face", highlight = "button1_highlight" },
			{ number = 2, face = "button2_face", highlight = "button2_highlight" },
			{ number = 3, face = "button3_face", highlight = "button3_highlight" },
			{ number = 4, face = "button4_face", highlight = "button4_highlight" },
			{ number = 5, face = "button5_face", highlight = "button5_highlight" },
			{ number = 6, face = "button6_face", highlight = "button6_highlight" },
			{ number = 7, face = "button7_face", highlight = "button7_highlight" },
			{ number = 8, face = "direction8_face", highlight = "direction8_highlight" },
			{ number = 9, face = "direction9_face", highlight = "direction9_highlight" },
			{ number = 10, face = "direction10_face", highlight = "direction10_highlight" },
			{ number = 11, face = "direction11_face", highlight = "direction11_highlight" },
			{ number = 12, face = "button12_face", highlight = "button12_highlight" },
			{ number = 13, face = "coin_acceptor_lamps" }
		}
		local maximum_level = 255
		local locked_coin_state = 256
		-- Filament response is nonlinear, but exponential relaxation is a useful compact model.
		-- With the exact lamp unknown, use the fast end of published miniature-lamp ranges:
		-- 100 ms to reach 90% brightness and 60 ms to decay to 10% brightness.
		local rise_time_to_90_percent = 0.10
		local fall_time_to_10_percent = 0.06
		local response_scale = math.log(10.0)

		local function state_callback(lamp)
			return function ()
				return math.floor(lamp.level + 0.5)
			end
		end

		local function coin_label_state_callback(label, lamp)
			return function ()
				return label.lockout:get() ~= 0 and locked_coin_state or math.floor(lamp.level + 0.5)
			end
		end

		file:set_resolve_tags_callback(
				function ()
					local view = file.views["Screen and Lamps"]
					local lamps = { }
					local coin_acceptor_lamp

					for _, item in ipairs(lamp_items) do
						local lamp = {
							output = file.device:output(string.format("lamp%u", item.number)),
							face = view.items[item.face],
							highlight = item.highlight and view.items[item.highlight] or nil }
						lamp.level = lamp.output:get() ~= 0 and maximum_level or 0
						lamp.face:set_element_state_callback(state_callback(lamp))
						if lamp.highlight then
							lamp.highlight:set_element_state_callback(state_callback(lamp))
						end
						if item.number == 13 then
							coin_acceptor_lamp = lamp
						end
						table.insert(lamps, lamp)
					end

					local coin_labels = {
						{ item = view.items["coin_a_label"], lockout = file.device:output("coin_lockout0") },
						{ item = view.items["coin_b_label"], lockout = file.device:output("coin_lockout1") },
						{ item = view.items["coin_c_label"], lockout = file.device:output("coin_lockout2") },
						{ item = view.items["coin_d_label"], lockout = file.device:output("coin_lockout3") }
					}
					for _, label in ipairs(coin_labels) do
						label.item:set_element_state_callback(coin_label_state_callback(label, coin_acceptor_lamp))
					end

					local previous_time = emu.attotime(machine.time)
					view:set_prepare_items_callback(
							function ()
								local current_time = machine.time
								local elapsed = (current_time - previous_time):as_double()
								previous_time = emu.attotime(current_time)
								local time_discontinuity = elapsed < 0 or elapsed > 0.25

								for _, lamp in ipairs(lamps) do
									local target = lamp.output:get() ~= 0 and maximum_level or 0
									if time_discontinuity then
										lamp.level = target
									elseif target ~= lamp.level then
										local response_time = target > lamp.level and rise_time_to_90_percent or fall_time_to_10_percent
										local fraction = 1.0 - math.exp(-response_scale * elapsed / response_time)
										lamp.level = lamp.level + (target - lamp.level) * fraction
										if math.abs(target - lamp.level) < 0.5 then
											lamp.level = target
										end
									end
								end
							end)
				end)
	]]></script>
</mamelayout>
