			<bounds x="-120" y="128" width="72" height="72" />
		</element>
		<element id="button1_face" name="lamp1" ref="lamp_blue" inputtag="STROBE0" inputmask="0x02">
			<bounds x="-120" y="236" width="72" height="72" />
		</element>
		<element ref="button_detail">
			<bounds x="-120" y="236" width="72" height="72" />
		</element>
		<element id="button1_highlight" name="lamp1" ref="button_highlight">
			<bounds x="-120" y="236" width="72" height="72" />
			<color red="0.43" green="0.49" blue="0.69" />
		</element>
		<element ref="lamp_label_1">
			<bounds x="-120" y="236" width="72" height="72" />
		</element>
		<element id="button2_face" name="lamp2" ref="lamp_pink" inputtag="STROBE0" inputmask="0x04">
