<mamelayout version="2">
	<element name="panel">
		<rect>
			<color red="0.05" green="0.05" blue="0.05" />
		</rect>
	</element>

	<element name="lamp" defstate="0">
		<rect state="0">
			<color red="0.30" green="0.24" blue="0.04" />
		</rect>
		<rect state="1">
			<color red="1.00" green="0.80" blue="0.10" />
		</rect>
	</element>
	<element name="lamp_violet" defstate="0">
		<rect state="0">
			<color red="0.20" green="0.05" blue="0.24" />
		</rect>
		<rect state="1">
			<color red="0.75" green="0.25" blue="0.90" />
		</rect>
	</element>
	<element name="lamp_blue" defstate="0">
		<rect state="0">
			<color red="0.03" green="0.08" blue="0.25" />
		</rect>
		<rect state="1">
			<color red="0.15" green="0.35" blue="1.00" />
		</rect>
	</element>
	<element name="lamp_pink" defstate="0">
		<rect state="0">
			<color red="0.28" green="0.06" blue="0.14" />
		</rect>
		<rect state="1">
			<color red="1.00" green="0.35" blue="0.65" />
		</rect>
	</element>
	<element name="lamp_orange" defstate="0">
		<rect state="0">
			<color red="0.30" green="0.12" blue="0.02" />
		</rect>
		<rect state="1">
			<color red="1.00" green="0.45" blue="0.05" />
		</rect>
	</element>
	<element name="lamp_green" defstate="0">
		<rect state="0">
			<color red="0.03" green="0.20" blue="0.05" />
		</rect>
		<rect state="1">
			<color red="0.10" green="0.90" blue="0.20" />
		</rect>
	</element>
	<element name="lamp_red" defstate="0">
		<rect state="0">
			<color red="0.28" green="0.03" blue="0.03" />
		</rect>
		<rect state="1">
			<color red="1.00" green="0.12" blue="0.08" />
		</rect>
	</element>

	<element name="lamp_label_0">
		<text string="A">
			<color red="0.00" green="0.00" blue="0.00" />
		</text>
	</element>
	<element name="lamp_label_1">
		<text string="B">
			<color red="0.00" green="0.00" blue="0.00" />
		</text>
	</element>
	<element name="lamp_label_2">
		<text string="C">
			<color red="0.00" green="0.00" blue="0.00" />
		</text>
	</element>
	<element name="lamp_label_3">
		<text string="COLLECT">
			<color red="0.00" green="0.00" blue="0.00" />
		</text>
	</element>
	<element name="lamp_label_4">
		<text string="START">
			<color red="0.00" green="0.00" blue="0.00" />
		</text>
	</element>
	<element name="lamp_label_5">
		<text string="C">
			<color red="0.00" green="0.00" blue="0.00" />
		</text>
	</element>
	<element name="lamp_label_6">
		<text string="B">
			<color red="0.00" green="0.00" blue="0.00" />
		</text>
	</element>
	<element name="lamp_label_7">
		<text string="A">
			<color red="0.00" green="0.00" blue="0.00" />
		</text>
	</element>

	<element name="lamp_label_8">
		<text string="LEFT">
			<color red="0.00" green="0.00" blue="0.00" />
		</text>
	</element>
	<element name="lamp_label_9">
		<text string="RIGHT">
			<color red="0.00" green="0.00" blue="0.00" />
		</text>
	</element>
	<element name="lamp_label_10">
		<text string="UP">
			<color red="0.00" green="0.00" blue="0.00" />
		</text>
	</element>
	<element name="lamp_label_11">
		<text string="DOWN">
			<color red="0.00" green="0.00" blue="0.00" />
		</text>
	</element>
	<element name="lamp_label_12">
		<text string="SELECT">
			<color red="0.00" green="0.00" blue="0.00" />
		</text>
	</element>
	<element name="lamp_label_13">
		<text string="COIN ACCEPTOR">
			<color red="0.00" green="0.00" blue="0.00" />
		</text>
	</element>

	<repeat count="5">
		<param name="n" start="14" increment="1" />
		<param name="group" start="5" increment="-1" />
		<element name="lamp_label_~n~">
			<text string="TELLY ~group~">
				<color red="0.00" green="0.00" blue="0.00" />
			</text>
		</element>
	</repeat>

	<repeat count="5">
		<param name="n" start="19" increment="1" />
		<param name="group" start="5" increment="-1" />
		<element name="lamp_label_~n~">
			<text string="ADDICTS ~group~">
				<color red="0.00" green="0.00" blue="0.00" />
			</text>
		</element>
	</repeat>

	<view name="Screen and Lamps">
		<screen index="0">
			<bounds x="0" y="0" width="768" height="576" />
		</screen>

		<element ref="panel">
			<bounds x="0" y="582" width="768" height="66" />
		</element>

		<element name="lamp0" ref="lamp_violet" inputtag="STROBE0" inputmask="0x01">
			<bounds x="80" y="586" width="70" height="16" />
		</element>
		<element name="lamp1" ref="lamp_blue" inputtag="STROBE0" inputmask="0x02">
			<bounds x="157" y="586" width="70" height="16" />
		</element>
		<element name="lamp2" ref="lamp_pink" inputtag="STROBE0" inputmask="0x04">
			<bounds x="234" y="586" width="70" height="16" />
		</element>
		<element name="lamp3" ref="lamp" inputtag="STROBE0" inputmask="0x08">
			<bounds x="311" y="586" width="70" height="16" />
		</element>
		<element name="lamp4" ref="lamp" inputtag="STROBE0" inputmask="0x10">
			<bounds x="388" y="586" width="70" height="16" />
		</element>
		<element name="lamp5" ref="lamp_orange" inputtag="STROBE0" inputmask="0x20">
			<bounds x="465" y="586" width="70" height="16" />
		</element>
		<element name="lamp6" ref="lamp_green" inputtag="STROBE0" inputmask="0x40">
			<bounds x="542" y="586" width="70" height="16" />
		</element>
		<element name="lamp7" ref="lamp_red" inputtag="STROBE0" inputmask="0x80">
			<bounds x="619" y="586" width="70" height="16" />
		</element>

		<repeat count="8">
			<param name="n" start="0" increment="1" />
			<param name="x" start="80" increment="77" />
			<element ref="lamp_label_~n~">
				<bounds x="~x~" y="586" width="70" height="16" />
			</element>
		</repeat>

		<repeat count="5">
			<param name="n" start="8" increment="1" />
			<param name="x" start="80" increment="77" />
			<param name="mask" start="0x01" lshift="1" />
			<element name="lamp~n~" ref="lamp" inputtag="STROBE1" inputmask="~mask~">
				<bounds x="~x~" y="607" width="70" height="16" />
			</element>
			<element ref="lamp_label_~n~">
				<bounds x="~x~" y="607" width="70" height="16" />
			</element>
		</repeat>

		<repeat count="3">
			<param name="n" start="13" increment="1" />
			<param name="x" start="465" increment="77" />
			<element name="lamp~n~" ref="lamp">
				<bounds x="~x~" y="607" width="70" height="16" />
			</element>
			<element ref="lamp_label_~n~">
				<bounds x="~x~" y="607" width="70" height="16" />
			</element>
		</repeat>

		<repeat count="8">
			<param name="n" start="16" increment="1" />
			<param name="x" start="80" increment="77" />
			<element name="lamp~n~" ref="lamp">
				<bounds x="~x~" y="628" width="70" height="16" />
			</element>
			<element ref="lamp_label_~n~">
				<bounds x="~x~" y="628" width="70" height="16" />
			</element>
		</repeat>
	</view>

	<view name="Screen Only">
		<screen index="0">
			<bounds x="0" y="0" width="768" height="576" />
		</screen>
	</view>
</mamelayout>
